# 啟動時會自動讀取 .env
# 預設為 demo 圖，先能跑起來；接 DVR 後換成 rtsp/http URL。
HOME_CAM_CAMERAS_JSON=[{"id":"ch1","name":"門口","url":"demo://ch1"},{"id":"ch2","name":"車庫","url":"demo://ch2"},{"id":"ch3","name":"曬衣區","url":"demo://ch3"},{"id":"ch4","name":"路邊","url":"demo://ch4"}]

# 若要接 iCATCH DVR WebSocket 串流，密碼只放本機 .env，不要提交 GitHub。
ICATCH_USER=admin
ICATCH_PASSWORD=
ICATCH_CAPTURE_SECONDS=8

# 若要用 Telegram 推圖，填 bot token 與 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RTSP 截圖逾時秒數
SNAPSHOT_TIMEOUT_SECONDS=12
